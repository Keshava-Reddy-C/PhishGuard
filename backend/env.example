# PhishGuard API Configuration Example
# Copy this file to .env and fill in your API keys

# Priority APIs (Highly Recommended for best accuracy)
# Get your Google Safe Browsing API key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFEBROWSING_API_KEY=your_google_safebrowsing_api_key_here

# Get your URLScan.io API key: https://urlscan.io/user/signup
URLSCAN_API_KEY=your_urlscan_api_key_here

# Secondary APIs (Optional - for additional detection layers)
# Get your VirusTotal API key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Get IBM X-Force credentials: https://exchange.xforce.ibmcloud.com/settings/api
IBM_XFORCE_API_KEY=your_xforce_api_key_here
IBM_XFORCE_API_PASSWORD=your_xforce_api_password_here

# Legacy/Additional APIs
PHISHTANK_API_KEY=your_phishtank_api_key_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_EMAIL=your_cloudflare_email_here

# Detection Priority Order:
# 1. Google Safe Browsing (if configured)
# 2. URLScan.io (if configured)
# 3. VirusTotal (if configured)
# 4. IBM X-Force (if configured)
# 5. PhishTank & other reputation databases
# 6. Machine Learning Model (fallback)

# Note: The system will work with just the ML model, but configuring
# at least Google Safe Browsing and URLScan.io is highly recommended
# for the most accurate real-time phishing detection.





